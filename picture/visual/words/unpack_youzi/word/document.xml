        <w:rPr>
          <w:rFonts w:hint="default"/>
        </w:rPr>
        <w:t>上午：熊猫基地（南门进，建议打车或直通车接驳车）。</w:t>
      </w:r>
      
    </w:p>
    <w:p w14:paraId="521787D3">
