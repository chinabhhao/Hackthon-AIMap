    <w:p w14:paraId="3663B394">
      <w:r>
        <w:t>出发地与交通</w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="default"/>
        </w:rPr>
        <w:t>：温州出发，乘晚上 7 点的飞机前往成都天府机场；返程为晚上航班。</w:t>
      </w:r>
    </w:p>
    <w:p w14:paraId="3B53CC11">
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="default"/>
        </w:rPr>
        <w:t>住宿信息：未明确提及具体酒店名称，但行程中提到在成都市区和九寨沟分别有住宿安排。</w:t>
      </w:r>
      
    </w:p>
    <w:p w14:paraId="257F0AC1">
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="default"/>
        </w:rPr>
        <w:t>核心目标：熊猫基地、九寨沟、都江堰、宽窄巷子、三星堆、成都市区美食与夜生活。</w:t>
      </w:r>
      
    </w:p>
