      <w:r>
        <w:t>Day 2：九寨沟游玩</w:t>
      </w:r>
    </w:p>
    <w:p w14:paraId="64247379">
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="default"/>
        </w:rPr>
        <w:t>全天：九寨沟景区（树正寨、原始森林、熊猫海、五花海等）。</w:t>
      </w:r>
      
    </w:p>
    <w:p w14:paraId="1FAF420D">
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="default"/>
        </w:rPr>
        <w:t>实用贴士：门票含普通观光车，分左线和右线；右线景点较多，建议先玩右线再回诺瑞朗中心转左线。</w:t>
      </w:r>
      
    </w:p>
    <w:p w14:paraId="136023F0">
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="default"/>
        </w:rPr>
        <w:t>文化背景：九寨沟是藏族聚居地，树正寨是九寨沟九个藏族村寨之一，保留了浓郁的藏族文化。</w:t>
      </w:r>
      
    </w:p>
    <w:p w14:paraId="4CF75ED4">
