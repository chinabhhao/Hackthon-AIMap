        <w:rPr>
          <w:rFonts w:hint="default"/>
        </w:rPr>
        <w:t>注意事项：九寨沟海拔较高，注意高原反应和保暖；熊猫基地建议提前预约门票；成都夏季阳光强烈，注意防晒。</w:t>
      </w:r>
      
    </w:p>
